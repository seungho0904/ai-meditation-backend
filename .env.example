# Copy to .env and adjust. Never commit .env.
DEBUG=false
PROJECT_NAME=AI Meditation API
API_V1_STR=/api/v1

# Comma-separated origins for Next.js local dev
CORS_ORIGINS=http://localhost:3000

# Product default locale when POST body omits `locale`: en | ko
APP_LOCALE=en

# --- LLM (Phase 1) ---
# openai | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_API_VERSION=2023-06-01
LLM_TIMEOUT_SECONDS=60

# Optional: override default REST URLs (rare)
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# --- ElevenLabs TTS (Phase 1) ---
ELEVENLABS_API_KEY=
# Default calm female (Sarah, "Bella-style") — see GET /api/v1/meditation/voice-presets for marcus_style etc.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
TTS_TIMEOUT_SECONDS=120
TTS_MAX_INPUT_CHARS=12000

# Optional: override API host (rare)
# ELEVENLABS_API_BASE=https://api.elevenlabs.io/v1
