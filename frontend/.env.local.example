# Copy to .env.local — never commit .env.local
#
# Local dev: leave NEXT_PUBLIC_API_BASE unset (or commented). The browser uses
# Next's /api-proxy rewrite to reach the API without CORS issues.
#
# Production / direct URL (optional for local dev if you set NEXT_PUBLIC_API_DIRECT):
# NEXT_PUBLIC_API_BASE=https://your-api.example.com

# First-visit UI locale: en | ko (user choice is stored in localStorage)
NEXT_PUBLIC_DEFAULT_LOCALE=en
